# Prowlarr: Settings -> General -> API Key
PROWLARR_API_KEY=
# Seerr: Settings -> General -> API Key
SEERR_API_KEY=

# Optional. Defaults shown.
# PROWLARR_URL=http://prowlarr:9696
# SEERR_URL=http://seerr:5055
# Where card links open. Empty = same host as this page, port 8000.
# SEERR_PUBLIC_URL=
# Seerr user id the requests are made as (empty = the API key owner, the admin).
# SEERR_USER_ID=

# Popularity filters
# MIN_SEEDERS=30
# MIN_VOTES_MOVIE=100
# MIN_VOTES_TV=100
# Movies released in the last N days; series with an episode aired in the last N days.
# MOVIE_MAX_AGE_DAYS=365
# MAX_AGE_DAYS=30
# Titles shown per row, and how many popular titles to check at most to fill it.
# MAX_ITEMS=80
# MAX_CANDIDATES=1000
# REFRESH_MINUTES=60
# Prowlarr searches are cached this long and spaced out by SEARCH_DELAY_MS.
# CHECK_HOURS=12
# SEARCH_DELAY_MS=1000
# A quality badge (1080p, 4K) shows when its best release has at least this many seeders.
# QUALITY_MIN_SEEDERS=5
